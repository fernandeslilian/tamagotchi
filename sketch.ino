#define ECHO_PIN 18
#define BUZZER_PIN 4

DHT dht(DHTPIN, DHTTYPE);

// Variáveis globais de telemetria e estado
float temperatura = 24.0;
float umidade = 50.0;
long distanciaCm = 80;

