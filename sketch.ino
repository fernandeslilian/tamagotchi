unsigned long ultimoPiscar = 0;
unsigned long ultimoEnvioMQTT = 0;

// --- LEITURA DO SENSOR ULTRASSÔNICO ---
long lerDistanciaCm() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long duracao = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duracao == 0) return 400;
  return duracao * 0.034 / 2;
}

// --- FUNÇÕES GRÁFICAS (DISPLAY OLED) ---
void desenharCabecalho() {
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.print((int)temperatura);
  display.print("C ");
  display.print((int)umidade);
  display.print("% ");
  display.print(distanciaCm);
  display.print("cm");

  // Indicador de conexão MQTT no canto direito
  display.setCursor(98, 0);
  if (mqttClient.connected()) {
    display.print("[ON]");
  } else {
    display.print("[--]");
  }
  display.drawLine(0, 10, 128, 10, SSD1306_WHITE);
}

void desenharCaixaFala(String texto) {
  display.drawRoundRect(0, 50, 128, 14, 3, SSD1306_WHITE);
  display.setCursor(4, 53);
  display.setTextSize(1);
  display.print(texto);
}

